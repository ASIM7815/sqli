# QueryQuest Environment Variables
# Copy this file to .env and fill in your values

# Flask Secret Key (Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=your_secret_key_here_64_characters_long

# CTF Flag (The flag participants need to find)
CTF_FLAG=CTF{your_unique_flag_here}

# Cookie Security (Set to 1 for HTTPS, 0 for local development)
COOKIE_SECURE=0
